# NewsAI Backend — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.

# ── AI (required) ──────────────────────────────────────────────────────────────
# Gemini API key for chat + digest + caching
# Free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ── Telugu TTS (required for voice) ────────────────────────────────────────────
# Sarvam Bulbul v3 API key
# Free signup at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here

# ── Semantic search (optional but recommended) ──────────────────────────────────
# HuggingFace token for MiniLM embeddings (free)
# Get at: https://huggingface.co/settings/tokens
HF_API_KEY=your_hf_token_here

# ── Admin API protection ────────────────────────────────────────────────────────
# Token required for /api/articles/reset and /api/analytics/summary
# Set to any long random string — e.g. openssl rand -hex 32
ADMIN_SECRET=your_secret_here

# ── Server port (optional — defaults to 3001) ───────────────────────────────────
PORT=3001
