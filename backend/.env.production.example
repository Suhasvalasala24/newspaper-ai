# ─────────────────────────────────────────────────────────────────────────────
# NewsAI Backend — Production Environment (Sakshi)
# Hand this file to Sakshi's server/DevOps team.
# Rename to .env and fill in every value before starting the server.
# NEVER commit .env with real keys to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI ─────────────────────────────────────────────────────────────────────
# Gemini API key — used for all chat responses and daily digest generation.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# Gemini model. gemini-2.5-flash-lite is free tier.
# Upgrade to a paid model once usage grows.
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Voice (TTS) ────────────────────────────────────────────────────────────
# Sarvam AI Bulbul v3 — Telugu & English text-to-speech.
# Get one at: https://console.sarvam.ai
SARVAM_API_KEY=PASTE_YOUR_SARVAM_KEY_HERE

# ── Embeddings (semantic search) ───────────────────────────────────────────
# HuggingFace key — used for article embeddings (semantic article matching).
# Free at: https://huggingface.co/settings/tokens
HF_API_KEY=PASTE_YOUR_HF_KEY_HERE

# ── Security ───────────────────────────────────────────────────────────────
# Protects admin endpoints (/api/admin/*, /api/scrape, etc.).
# Generate any strong random string: openssl rand -hex 32
ADMIN_SECRET=PASTE_A_STRONG_RANDOM_SECRET_HERE

# ── CORS ───────────────────────────────────────────────────────────────────
# Only these origins can call the backend. Sakshi's domains.
# Separate multiple domains with commas (no spaces).
ALLOWED_ORIGINS=https://www.sakshi.com,https://sakshi.com,https://m.sakshi.com

# ── Server ─────────────────────────────────────────────────────────────────
# Port the Node.js server listens on. Nginx/Caddy reverse-proxies to this.
PORT=3001
NODE_ENV=production
