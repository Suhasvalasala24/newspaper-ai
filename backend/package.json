{
  "name": "newsai-backend",
  "version": "1.0.0",
  "description": "NewsAI backend — PDF ingestion and web scraping endpoints",
  "main": "server.js",
  "scripts": {
    "start":        "node server.js",
    "dev":          "node --watch server.js",
    "build:widget": "npx esbuild ../widget/newsai-widget.js --bundle=false --minify --outfile=../widget/newsai-widget.min.js",
    "build:ext":    "npx esbuild ../extension/widget/newsai-widget.js --bundle=false --minify --outfile=../extension/widget/newsai-widget.min.js",
    "sync:ext":     "cd .. && bash sync-extension.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "cheerio":    "^1.0.0",
    "cors":       "^2.8.5",
    "dotenv":     "^16.4.5",
    "express":    "^4.18.2",
    "node-fetch": "^2.7.0",
    "pdf-parse":  "^1.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
